# =====================================================================
# ENVIRONMENT CONFIGURATION - ADV. UPNISHAD SHARMA WEBSITE
# =====================================================================

# Canonical site domain (used for metadata, OpenGraph, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://www.advupnishadsharma.com

# Node environment
NODE_ENV=production

# ---------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Optional - for real email notification dispatch)
# If left empty, contact form submissions log safely to server stdout.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=S.upnishad99@gmail.com
SMTP_PASS=your-google-app-password-here
CONTACT_NOTIFICATION_EMAIL=S.upnishad99@gmail.com

# ---------------------------------------------------------------------
# GOOGLE MAPS EMBED (Optional)
# If using Google Maps Embed API instead of standard iframe
# ---------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
